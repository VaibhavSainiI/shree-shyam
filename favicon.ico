<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="favicon-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d4a574;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8b4513;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background circle -->
  <circle cx="32" cy="32" r="30" fill="url(#favicon-bg)"/>
  <circle cx="32" cy="32" r="30" fill="none" stroke="#ffd700" stroke-width="2"/>
  
  <!-- Stylized "S" for Shree Shyam -->
  <path d="M20,20 Q15,15 20,10 Q30,8 35,15 Q30,18 25,16 Q35,22 40,28 Q45,35 40,42 Q30,45 25,38 Q30,35 35,37 Q25,31 20,25 Q15,18 20,20" fill="white" stroke="#ffd700" stroke-width="1"/>
  
  <!-- Decorative dots -->
  <circle cx="18" cy="32" r="2" fill="#ffd700"/>
  <circle cx="46" cy="32" r="2" fill="#ffd700"/>
  <circle cx="32" cy="18" r="2" fill="#ffd700"/>
  <circle cx="32" cy="46" r="2" fill="#ffd700"/>
</svg>