# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/shreeshyamcollection

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_very_long_and_complex
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Email Configuration (for order confirmations, password reset, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@shreeshyamcollection.com

# Payment Gateway Configuration
# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Razorpay (for Indian payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# File Upload Configuration
# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
BCRYPT_SALT_ROUNDS=12
COOKIE_SECRET=your_cookie_secret_here

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Admin Configuration
ADMIN_EMAIL=admin@shreeshyamcollection.com
ADMIN_PASSWORD=admin123

# SMS Gateway (for order updates)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=SHRCOL

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Social Media API Keys (if needed for social login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Shipping Configuration
SHIPPING_API_KEY=your_shipping_api_key
FREE_SHIPPING_THRESHOLD=1999

# Tax Configuration
GST_RATE=0.18
HSN_CODE=6204

# Inventory Management
LOW_STOCK_THRESHOLD=10
AUTO_REORDER_ENABLED=false

# Performance Monitoring
NEW_RELIC_LICENSE_KEY=your_new_relic_key
SENTRY_DSN=your_sentry_dsn