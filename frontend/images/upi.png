<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 60">
  <defs>
    <linearGradient id="upi-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff6b35;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f7931e;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Card background -->
  <rect width="100" height="60" rx="8" ry="8" fill="url(#upi-bg)"/>
  <rect width="100" height="60" rx="8" ry="8" fill="none" stroke="#ddd" stroke-width="1"/>
  
  <!-- UPI logo design -->
  <circle cx="25" cy="25" r="8" fill="white"/>
  <text x="25" y="30" font-family="Arial, sans-serif" font-size="10" font-weight="bold" text-anchor="middle" fill="#ff6b35">₹</text>
  
  <!-- UPI text -->
  <text x="65" y="35" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="white">UPI</text>
  
  <!-- Decorative elements -->
  <rect x="5" y="50" width="90" height="2" fill="rgba(255,255,255,0.3)"/>
  <path d="M40,15 L45,20 L40,25 L35,20 Z" fill="white" opacity="0.7"/>
  <path d="M55,15 L60,20 L55,25 L50,20 Z" fill="white" opacity="0.7"/>
</svg>