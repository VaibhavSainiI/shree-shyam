<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 400">
  <defs>
    <linearGradient id="member3-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#a29bfe;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#6c5ce7;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="400" fill="url(#member3-bg)"/>
  
  <!-- Profile silhouette -->
  <circle cx="150" cy="120" r="60" fill="rgba(255,255,255,0.9)"/>
  <circle cx="150" cy="120" r="50" fill="#c39bd3"/>
  
  <!-- Face features -->
  <circle cx="135" cy="110" r="4" fill="#333"/>
  <circle cx="165" cy="110" r="4" fill="#333"/>
  <path d="M140,130 Q150,140 160,130" stroke="#333" stroke-width="2" fill="none"/>
  
  <!-- Hair -->
  <path d="M100,90 Q150,70 200,90 Q185,80 150,80 Q115,80 100,90" fill="#2c3e50"/>
  
  <!-- Body/Traditional wear -->
  <rect x="100" y="180" width="100" height="150" fill="#fdcb6e" opacity="0.8" rx="10"/>
  
  <!-- Traditional Indian clothing details -->
  <ellipse cx="150" cy="200" rx="30" ry="8" fill="#e17055"/>
  <circle cx="130" cy="230" r="7" fill="#e17055"/>
  <circle cx="150" cy="245" r="7" fill="#e17055"/>
  <circle cx="170" cy="230" r="7" fill="#e17055"/>
  <path d="M120,280 Q150,270 180,280" stroke="#e17055" stroke-width="4" fill="none"/>
  
  <!-- Decorative border -->
  <rect x="10" y="10" width="280" height="380" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="2" rx="15"/>
  
  <!-- Name plate -->
  <rect x="50" y="340" width="200" height="40" fill="rgba(255,255,255,0.9)" rx="5"/>
  <text x="150" y="360" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="#333">Anita Verma</text>
  <text x="150" y="375" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#666">Quality Manager</text>
</svg>