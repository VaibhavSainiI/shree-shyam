<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400">
  <defs>
    <linearGradient id="preview-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
    <pattern id="craft-pattern" patternUnits="userSpaceOnUse" width="30" height="30">
      <circle cx="15" cy="15" r="8" fill="rgba(255,255,255,0.1)"/>
      <path d="M15,5 Q20,10 25,15 Q20,20 15,25 Q10,20 5,15 Q10,10 15,5" fill="rgba(255,255,255,0.05)"/>
    </pattern>
  </defs>
  
  <!-- Background -->
  <rect width="600" height="400" fill="url(#preview-bg)"/>
  <rect width="600" height="400" fill="url(#craft-pattern)"/>
  
  <!-- Artisan working -->
  <ellipse cx="300" cy="200" rx="150" ry="100" fill="rgba(255,255,255,0.2)"/>
  
  <!-- Hands crafting -->
  <ellipse cx="250" cy="180" rx="30" ry="20" fill="#d4a574" opacity="0.8"/>
  <ellipse cx="350" cy="180" rx="30" ry="20" fill="#d4a574" opacity="0.8"/>
  
  <!-- Fabric being worked on -->
  <rect x="220" y="220" width="160" height="80" fill="#ff6b6b" opacity="0.7" rx="5"/>
  
  <!-- Embroidery pattern -->
  <circle cx="250" cy="250" r="8" fill="#ffd700"/>
  <circle cx="300" cy="260" r="8" fill="#ffd700"/>
  <circle cx="350" cy="250" r="8" fill="#ffd700"/>
  <path d="M250,250 Q275,240 300,250 Q325,260 350,250" stroke="#ffd700" stroke-width="3" fill="none"/>
  
  <!-- Traditional tools -->
  <rect x="150" y="300" width="40" height="8" fill="#8b4513" rx="4"/>
  <rect x="410" y="300" width="40" height="8" fill="#8b4513" rx="4"/>
  
  <!-- Decorative border -->
  <rect x="20" y="20" width="560" height="360" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="3" rx="10"/>
  
  <!-- Text overlay -->
  <rect x="0" y="320" width="600" height="80" fill="rgba(0,0,0,0.5)"/>
  <text x="300" y="355" font-family="Arial, sans-serif" font-size="28" font-weight="bold" text-anchor="middle" fill="white">Traditional Craftsmanship</text>
  <text x="300" y="375" font-family="Arial, sans-serif" font-size="14" text-anchor="middle" fill="gold">Handcrafted with Love & Tradition</text>
</svg>