<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 400">
  <defs>
    <linearGradient id="member2-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fd79a8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e84393;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="400" fill="url(#member2-bg)"/>
  
  <!-- Profile silhouette -->
  <circle cx="150" cy="120" r="60" fill="rgba(255,255,255,0.9)"/>
  <circle cx="150" cy="120" r="50" fill="#ddb892"/>
  
  <!-- Face features -->
  <circle cx="135" cy="110" r="4" fill="#333"/>
  <circle cx="165" cy="110" r="4" fill="#333"/>
  <path d="M140,130 Q150,140 160,130" stroke="#333" stroke-width="2" fill="none"/>
  
  <!-- Hair -->
  <path d="M100,85 Q150,65 200,85 Q185,75 150,75 Q115,75 100,85" fill="#8b4513"/>
  
  <!-- Body/Traditional wear -->
  <rect x="100" y="180" width="100" height="150" fill="#00b894" opacity="0.8" rx="10"/>
  
  <!-- Traditional Indian clothing details -->
  <rect x="110" y="190" width="80" height="8" fill="#ffd700"/>
  <rect x="110" y="205" width="80" height="8" fill="#ffd700"/>
  <circle cx="150" cy="230" r="10" fill="#ffd700"/>
  <polygon points="130,260 150,250 170,260 150,270" fill="#ffd700"/>
  
  <!-- Decorative border -->
  <rect x="10" y="10" width="280" height="380" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="2" rx="15"/>
  
  <!-- Name plate -->
  <rect x="50" y="340" width="200" height="40" fill="rgba(255,255,255,0.9)" rx="5"/>
  <text x="150" y="360" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="#333">Rajesh Kumar</text>
  <text x="150" y="375" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#666">Master Craftsman</text>
</svg>