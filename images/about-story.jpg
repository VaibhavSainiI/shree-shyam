<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500">
  <defs>
    <linearGradient id="story-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffecd2;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fcb69f;stop-opacity:1" />
    </linearGradient>
    <pattern id="weave-pattern" patternUnits="userSpaceOnUse" width="20" height="20">
      <path d="M0,10 L20,10 M10,0 L10,20" stroke="rgba(139,69,19,0.2)" stroke-width="1"/>
    </pattern>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="500" fill="url(#story-bg)"/>
  <rect width="800" height="500" fill="url(#weave-pattern)"/>
  
  <!-- Traditional loom representation -->
  <rect x="100" y="150" width="250" height="200" fill="#8b4513" opacity="0.3" rx="10"/>
  
  <!-- Textile being woven -->
  <rect x="120" y="170" width="210" height="160" fill="#d4a574" opacity="0.8"/>
  
  <!-- Weaving threads -->
  <line x1="120" y1="180" x2="330" y2="180" stroke="#8b4513" stroke-width="2"/>
  <line x1="120" y1="200" x2="330" y2="200" stroke="#d4a574" stroke-width="2"/>
  <line x1="120" y1="220" x2="330" y2="220" stroke="#8b4513" stroke-width="2"/>
  <line x1="120" y1="240" x2="330" y2="240" stroke="#d4a574" stroke-width="2"/>
  <line x1="120" y1="260" x2="330" y2="260" stroke="#8b4513" stroke-width="2"/>
  <line x1="120" y1="280" x2="330" y2="280" stroke="#d4a574" stroke-width="2"/>
  <line x1="120" y1="300" x2="330" y2="300" stroke="#8b4513" stroke-width="2"/>
  <line x1="120" y1="320" x2="330" y2="320" stroke="#d4a574" stroke-width="2"/>
  
  <!-- Vertical threads -->
  <line x1="140" y1="170" x2="140" y2="330" stroke="#daa520" stroke-width="1"/>
  <line x1="160" y1="170" x2="160" y2="330" stroke="#daa520" stroke-width="1"/>
  <line x1="180" y1="170" x2="180" y2="330" stroke="#daa520" stroke-width="1"/>
  <line x1="200" y1="170" x2="200" y2="330" stroke="#daa520" stroke-width="1"/>
  <line x1="220" y1="170" x2="220" y2="330" stroke="#daa520" stroke-width="1"/>
  <line x1="240" y1="170" x2="240" y2="330" stroke="#daa520" stroke-width="1"/>
  <line x1="260" y1="170" x2="260" y2="330" stroke="#daa520" stroke-width="1"/>
  <line x1="280" y1="170" x2="280" y2="330" stroke="#daa520" stroke-width="1"/>
  <line x1="300" y1="170" x2="300" y2="330" stroke="#daa520" stroke-width="1"/>
  <line x1="310" y1="170" x2="310" y2="330" stroke="#daa520" stroke-width="1"/>
  
  <!-- Traditional Indian motifs -->
  <circle cx="500" cy="200" r="40" fill="none" stroke="#8b4513" stroke-width="3"/>
  <path d="M500,170 Q520,180 530,200 Q520,220 500,230 Q480,220 470,200 Q480,180 500,170" fill="#d4a574" opacity="0.6"/>
  
  <!-- Decorative elements -->
  <circle cx="600" cy="300" r="25" fill="#daa520" opacity="0.7"/>
  <polygon points="600,280 615,295 600,310 585,295" fill="#8b4513" opacity="0.8"/>
  
  <!-- Text overlay -->
  <rect x="0" y="400" width="800" height="100" fill="rgba(139,69,19,0.8)"/>
  <text x="400" y="440" font-family="Arial, sans-serif" font-size="36" font-weight="bold" text-anchor="middle" fill="white">Our Heritage Story</text>
  <text x="400" y="470" font-family="Arial, sans-serif" font-size="18" text-anchor="middle" fill="#ffecd2">Weaving Traditions Since Generations</text>
</svg>