<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 60">
  <defs>
    <linearGradient id="mc-bg" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#eb001b;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#f79e1b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ff5f00;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Card background -->
  <rect width="100" height="60" rx="8" ry="8" fill="url(#mc-bg)"/>
  <rect width="100" height="60" rx="8" ry="8" fill="none" stroke="#ddd" stroke-width="1"/>
  
  <!-- Mastercard circles -->
  <circle cx="35" cy="30" r="12" fill="#eb001b" opacity="0.8"/>
  <circle cx="45" cy="30" r="12" fill="#f79e1b" opacity="0.8"/>
  
  <!-- Mastercard text -->
  <text x="70" y="20" font-family="Arial, sans-serif" font-size="8" font-weight="bold" text-anchor="middle" fill="white">master</text>
  <text x="70" y="42" font-family="Arial, sans-serif" font-size="8" font-weight="bold" text-anchor="middle" fill="white">card</text>
  
  <!-- Decorative elements -->
  <rect x="5" y="50" width="90" height="2" fill="rgba(255,255,255,0.3)"/>
</svg>