<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 400">
  <defs>
    <linearGradient id="member1-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#74b9ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0984e3;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="300" height="400" fill="url(#member1-bg)"/>
  
  <!-- Profile silhouette -->
  <circle cx="150" cy="120" r="60" fill="rgba(255,255,255,0.9)"/>
  <circle cx="150" cy="120" r="50" fill="#d4a574"/>
  
  <!-- Face features -->
  <circle cx="135" cy="110" r="4" fill="#333"/>
  <circle cx="165" cy="110" r="4" fill="#333"/>
  <path d="M140,130 Q150,140 160,130" stroke="#333" stroke-width="2" fill="none"/>
  
  <!-- Hair -->
  <path d="M100,90 Q150,70 200,90 Q180,80 150,80 Q120,80 100,90" fill="#2d3436"/>
  
  <!-- Body/Traditional wear -->
  <rect x="100" y="180" width="100" height="150" fill="#fd79a8" opacity="0.8" rx="10"/>
  
  <!-- Traditional Indian clothing details -->
  <rect x="110" y="190" width="80" height="10" fill="#ffd700"/>
  <circle cx="150" cy="220" r="8" fill="#ffd700"/>
  <circle cx="130" cy="250" r="6" fill="#ffd700"/>
  <circle cx="170" cy="250" r="6" fill="#ffd700"/>
  
  <!-- Decorative border -->
  <rect x="10" y="10" width="280" height="380" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="2" rx="15"/>
  
  <!-- Name plate -->
  <rect x="50" y="340" width="200" height="40" fill="rgba(255,255,255,0.9)" rx="5"/>
  <text x="150" y="360" font-family="Arial, sans-serif" font-size="16" font-weight="bold" text-anchor="middle" fill="#333">Priya Sharma</text>
  <text x="150" y="375" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#666">Design Director</text>
</svg>